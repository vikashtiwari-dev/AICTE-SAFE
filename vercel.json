{
  "version": 2,
  "env": {
    "DATABASE_URL": "postgresql://postgres.dvqlzghhzfezbdtlsnoc:REDACTED_DATABASE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres",
    "JWT_SECRET": "REDACTED_JWT_SECRET",
    "CRON_SECRET": "REDACTED_CRON_SECRET",
    "NODE_ENV": "production"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/alerts/cron-check",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
